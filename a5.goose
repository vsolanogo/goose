
fn main() {
    var status = "PENDING";

    defer {
        print("Transaction: ", status);
    }

    status = "COMMITTED";

    print("Main: ", status);
}

// Для эксперимента №5 предлагаю взять баг, который особенно неприятен разработчикам системного ПО: отложенная операция выполняется не с теми данными, с которыми была зарегистрирована.

// Это не race condition, не проблема памяти и не арифметика.

// Это ловушка в управлении временем выполнения кода.
// Эксперимент №5: машина времени внутри defer
// Deferred execution bug
//  Control flow semantics


// Представь сервер банковских транзакций. Он регистрирует отложенную запись в журнал, рассчитывая, что туда попадёт состояние транзакции на момент регистрации.

// Но состояние изменяется до выполнения defer.

// В результате журнал сообщает, что операция успешно завершена, хотя программист рассчитывал записать первоначальное состояние.
// 1. Сначала посмотрим на Go
// В Go аргументы отложенного вызова вычисляются непосредственно в момент регистрации defer.
// package main

// import "fmt"

// func main() {
//     status := "PENDING"

//     defer fmt.Println("Transaction:", status)

//     status = "COMMITTED"

//     fmt.Println("Main:", status)
// }


// Результат:
// Main: COMMITTED
// Transaction: PENDING


// Почему? Потому что Go сохранил аргумент "PENDING" при регистрации отложенного вызова. 
// The Go Programming Language

// 2. Теперь Goose: тот же эксперимент
// В Goose отложенный блок defer { ... } выполняется при выходе из блока. Он видит значения переменных именно на момент выхода, а не регистрации.

// fn main() {
//     var status = "PENDING";

//     defer {
//         print("Transaction: ", status);
//     }

//     status = "COMMITTED";

//     print("Main: ", status);
// }



// Результат:
// Main: COMMITTED
// Transaction: COMMITTED


// Сюрприз
// Goose не сохранил старое значение status. Отложенный блок прочитал актуальное значение при выполнении.

// Это прямо описано в спецификации Goose: тело defer вычисляется при выходе из блока. 
// Goose+1

// 3. Где это может превратиться в настоящий баг?
// Представим систему обработки платежей:
// fn process_payment() {
//     var approved = false;
//     var amount = 1000;

//     defer {
//         if approved {
//             print("AUDIT: payment approved: ", amount);
//         } else {
//             print("AUDIT: payment rejected: ", amount);
//         }
//     }

//     // Проверяем платёж.
//     approved = true;

//     // Обнаруживаем подозрительную активность.
//     amount = 0;
// }


// При выходе получим:
// AUDIT: payment approved: 0


// Отложенная операция увидела изменённую переменную amount.

// Это может привести к очень неприятным ошибкам аудита, логирования и очистки ресурсов.
// 4. Как исправить в Goose?
// Если нам необходимо именно первоначальное состояние, создаём снимки переменных:

// fn process_payment() {
//     var approved = false;
//     var amount = 1000;

//     // Сохраняем снимки.
//     let audit_approved = approved;
//     let audit_amount = amount;

//     defer {
//         if audit_approved {
//             print("AUDIT: payment approved: ", audit_amount);
//         } else {
//             print("AUDIT: payment rejected: ", audit_amount);
//         }
//     }

//     approved = true;
//     amount = 0;
// }



// Теперь журнал получит:
// AUDIT: payment rejected: 1000


// 5. Сравнение семантики
// Особенность	Go	Goose
// defer	Отложенный вызов	Отложенный оператор или блок
// Когда вычисляются аргументы вызова	При регистрации	При выполнении отложенного оператора
// Когда читаются переменные в блоке	При выполнении closure	При выполнении блока
// Порядок выполнения	LIFO	LIFO
// Выполнение при обычном return	Да	Да
// Выполнение при abort	Нет	Нет

// Важное уточнение: Go closures тоже могут читать изменённые переменные. Отличие здесь именно между отложенным вызовом с аргументами и отложенным блоком.

// 6. Ещё одна интересная особенность Goose
// defer выполняется при выходе из своего блока, а не обязательно при выходе из функции.

// Например:
// fn main() {
//     print("A");

//     {
//         defer print("C");
//         print("B");
//     }

//     print("D");
// }


// Результат:
// A
// B
// C
// D


// То есть Goose позволяет использовать defer как механизм управления временем жизни локальных операций и ресурсов.

// Вот что мне нравится в этом эксперименте: один и тот же синтаксический приём в двух языках имеет немного разную семантику. И если механически переносить привычки из Go в Goose, можно получить совершенно неожиданные результаты.

// Документация: Goose Language Reference — defer.