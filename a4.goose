
fn main() {
    var original: u8[>..] = [10, 20, 30, 40, 50];

    // Кажется, что создаём backup.
    // На самом деле backup ссылается на original.
    let backup = original;

    print("Original before: ", original);
    print("Backup before:   ", backup);

    // Меняем якобы резервную копию.
    backup[0] = 255;
    backup[1] = 255;

    print("Original after:  ", original);
    print("Backup after:    ", backup);
}

// Теперь предлагаю совершенно другой тип катастрофы. Не арифметика, не многопоточность, не точность float.
// Эксперимент №4: программа удаляет чужие данные, хотя программист уверен, что работает с копией
// Aliasing / Shared mutable state
// Представь, что мы пишем сервер обработки изображений. Он получает массив пикселей, создаёт его копию для обработки, обрезает изображение, а затем возвращает оригинал.

// Но из-за особенностей работы со ссылочными типами «копия» на самом деле оказывается ссылкой на те же данные.

// Это называется Aliasing — несколько переменных указывают на один и тот же объект в памяти.

// Именно так можно случайно уничтожить исходные данные, испортить кэш или повредить состояние совершенно другого компонента программы.
// 1. Сценарий
// Допустим, у нас есть:
// - original — оригинальное изображение.
// - backup — якобы независимая копия.
// - crop() — функция, удаляющая часть пикселей.
// Программист думает, что изменяет только backup.
// 2. Воспроизводим баг
// В Goose есть очень интересная особенность: нефиксированные массивы не копируются автоматически.

// Посмотри:

// fn main() {
//     var original: u8[>..] = [10, 20, 30, 40, 50];

//     // Кажется, что создаём backup.
//     // На самом деле backup ссылается на original.
//     let backup = original;

//     print("Original before: ", original);
//     print("Backup before:   ", backup);

//     // Меняем якобы резервную копию.
//     backup[0] = 255;
//     backup[1] = 255;

//     print("Original after:  ", original);
//     print("Backup after:    ", backup);
// }



// Результат:
// Original before: [10, 20, 30, 40, 50]
// Backup before:   [10, 20, 30, 40, 50]

// Original after:  [255, 255, 30, 40, 50]
// Backup after:    [255, 255, 30, 40, 50]


// Оригинал повреждён
// Здесь нет нарушения memory safety. Нет выхода за границы массива. Нет неопределённого поведения.

// Просто две переменные обращаются к одному массиву.
// 3. Как это выглядит в памяти
// До изменения
// original


// backup


// Один массив в памяти
// 10

// 20

// 30

// 40

// 50





// После изменения backup
// Тот же самый массив
// 255

// 255

// 30

// 40

// 50


// Изменения видны через обе переменные.


// 4. Правильная версия: настоящая копия
// В Goose для этого предусмотрена специальная функция copy().

// fn main() {
//     var original: u8[>..] = [10, 20, 30, 40, 50];

//     // Явное глубокое копирование массива.
//     var backup = copy(original);

//     backup[0] = 255;
//     backup[1] = 255;

//     print("Original: ", original);
//     print("Backup:   ", backup);
// }



// Результат:
// Original: [10, 20, 30, 40, 50]
// Backup:   [255, 255, 30, 40, 50]


// Важный момент: copy() копирует элементы массива. Если сами элементы содержат ссылки, копируются ссылки, а не обязательно объекты, на которые они указывают. Это не универсальное рекурсивное клонирование графа объектов.
// 5. А теперь самое интересное: Goose не запрещает aliasing
// В отличие от некоторых языков с жёсткими правилами эксклюзивного владения, Goose допускает несколько ссылок на один объект.

// Например:
// Возможность	Goose
// Несколько ссылок на массив	Да
// Изменение через ссылку	Да
// Неявное копирование больших массивов	Нет
// Явное копирование через copy()	Да
// Dangling references	Контролируются системой lifetime
// Aliasing сам по себе запрещён	Нет


// Goose+2
// И вот почему этот эксперимент интересен: Goose защищает память, но не пытается автоматически защищать программиста от всех логических ошибок.
// 6. Ещё более неприятный вариант
// Представь, что у тебя есть массив объектов:
// Image
//  ├── pixels
//  ├── metadata
//  └── dimensions


// Ты копируешь массив Image, но внутри каждого объекта находятся ссылки на общие буферы пикселей.

// В итоге у тебя могут быть две независимые структуры Image, которые одновременно изменяют один и тот же pixel buffer.

// Это уже shallow copy против deep copy — проблема, с которой сталкиваются разработчики C++, JavaScript, Python, C# и многих других языков.

// Мой следующий кандидат для эксперимента №5: use-after-free в классическом C/C++ превращается в совершенно другой, но не менее коварный сценарий в Goose — stale reference и type-safe memory reuse. Там ссылка остаётся валидной с точки зрения памяти, но начинает указывать на совершенно другие данные того же типа. Это особенно интересная особенность Goose.